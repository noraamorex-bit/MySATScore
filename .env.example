# --- Database -------------------------------------------------------------
# The repository is configured for PostgreSQL, which is what it deploys onto.
# Use the POOLED connection string from your provider (Supabase: "Transaction
# pooler", port 6543) and keep the pgbouncer parameters.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# To develop locally with no database server at all, switch to SQLite:
#   npm run db:use-sqlite
#   # then set:  DATABASE_URL="file:./dev.db"
#   npm run setup
# `npm run db:use-postgres` switches back before you deploy.

# --- Auth -----------------------------------------------------------------
# 32+ char secret used to sign session cookies. CHANGE THIS IN PRODUCTION.
AUTH_SECRET="dev-only-secret-change-me-please-32chars"

# Email address that is granted the ADMIN role when it registers or is seeded.
ADMIN_EMAIL="admin@mysatscore.local"
ADMIN_PASSWORD="admin12345"
