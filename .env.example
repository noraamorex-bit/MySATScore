# --- Database -------------------------------------------------------------
# Default: zero-config SQLite so the app runs immediately after `npm run setup`.
DATABASE_URL="file:./dev.db"

# To use PostgreSQL / Supabase instead:
#   1. npm run db:use-postgres
#   2. set DATABASE_URL below, e.g.
#      DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
#   3. npm run setup

# --- Auth -----------------------------------------------------------------
# 32+ char secret used to sign session cookies. CHANGE THIS IN PRODUCTION.
AUTH_SECRET="dev-only-secret-change-me-please-32chars"

# Email address that is granted the ADMIN role when it registers or is seeded.
ADMIN_EMAIL="admin@mysatscore.local"
ADMIN_PASSWORD="admin12345"
