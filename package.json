{
  "name": "mysatscore",
  "version": "1.0.0",
  "private": true,
  "description": "MySATScore — a Digital SAT practice platform with adaptive full-length mock tests.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bank:build": "tsx content/generators/build.ts",
    "bank:verify": "tsx content/generators/verify.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:use-postgres": "tsx scripts/switch-db.ts postgresql",
    "db:use-sqlite": "tsx scripts/switch-db.ts sqlite",
    "seed": "tsx scripts/seed.ts",
    "setup": "prisma generate && prisma db push --skip-generate && tsx scripts/seed.ts",
    "test:flow": "tsx scripts/test-flow.ts",
    "postinstall": "prisma generate",
    "test:admin": "tsx scripts/test-admin.ts",
    "test": "npm run bank:verify && npm run test:flow && npm run test:admin"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "clsx": "^2.1.1",
    "katex": "^0.16.22",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
